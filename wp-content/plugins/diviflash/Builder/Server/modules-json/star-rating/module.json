          "name": "divi/composite",
          "props": {
            "groupLabel": "Rating"
          }
        }
      },
      "design_rating_number": {
        "panel": "design",
        "groupName": "design_rating_number",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Rating Number"
          }
        }
      },
      "design_title": {
        "panel": "design",
        "groupName": "design_title",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Title Style"
          }
        }
      },
      "design_content": {
        "panel": "design",
        "groupName": "design_content",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content Style"
          }
        }
      },
      "design_content_text": {
        "panel": "design",
        "groupName": "design_content_text",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content Text"
          }
        }
      },
      "design_content_heading": {
        "panel": "design",
        "groupName": "design_content_heading",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content Heading Text"
          }
        }
      },
      "contentSpacing": {
        "panel": "design",
        "groupName": "contentSpacing",
        "priority": 80,
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Spacing"
          }
        }
      }
    }
  },
  "customCssFields": {
    "rating_css": {
      "subName": "rating_css",
      "label": "Rating Icon",
      "selectorSuffix": " .df_rating_wrapper .df_rating_icon span.et-pb-icon"
    },
    "rating_before_css": {
      "subName": "rating_before_css",
      "label": "Rating Icon Before",
      "selectorSuffix": " .df_rating_wrapper .df_rating_icon span.df_rating_icon_fill::before"
    },
    "rating_after_css": {
      "subName": "rating_after_css",
      "label": "Rating Icon After",
      "selectorSuffix": " .df_rating_wrapper .df_rating_icon span.df_rating_icon_empty::after"
    },
    "rating_number_css": {
      "subName": "rating_number_css",
      "label": "Rating Number",
      "selectorSuffix": " .df_rating_wrapper span.df_rating_number"
    },
    "rating_title_css": {
      "subName": "rating_title_css",
      "label": "Rating Title",
      "selectorSuffix": " .df_rating_wrapper .df_rating_title"
    },
    "rating_content_css": {
      "subName": "rating_content_css",
      "label": "Rating Content",
      "selectorSuffix": " .df_rating_box_container .df_rating_content"
    }
