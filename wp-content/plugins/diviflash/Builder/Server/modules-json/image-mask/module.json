{
  "name": "difl/imagemask",
  "d4Shortcode": "difl_imagemask",
  "title": "Image Mask",
  "titles": "Image Masks",
  "category": "module",
  "moduleIcon": "difl/image-masking",
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "image": {
        "panel": "content",
        "groupName": "image",
        "multiElements": true,
        "priority": 0,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image"
          }
        }
      },
      "mask_settings": {
        "panel": "content",
        "groupName": "mask_settings",
        "priority": 1,
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Mask Settings"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {
          "link": {}
        },
        "decoration": {
          "attributes": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "background": {},
          "boxShadow": {},
          "interactions": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "conditions": {},
          "disabledOn": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "sticky": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Image Mask"
            }
          }
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      }
    },
    "image": {
      "type": "object",
      "selector": "{{selector}} img",
      "elementType": "imageLink",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "src": {
              "groupSlug": "image",
              "subName": "src",
              "label": "Image",
              "description": "Upload an image.",
              "features": {
                "dynamicContent": {
                  "type": "image"
                },
                "sticky": false,
                "responsive": true,
                "hover": true,
                "preset": "content"
              },
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": true
                }
              }
            },
            "alt": {
              "groupSlug": "image",
              "subName": "alt",
              "label": "Image Alt Text",
              "description": "This defines the HTML ALT text. A short description of your image can be placed here.",
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "sticky": false,
                "responsive": false,
                "hover": false,
                "preset": "content"
              },
              "render": true,
              "priority": 30,
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "full_width": {
              "groupSlug": "mask_settings",
              "render": true,
              "priority": "3",
              "subName": "full_width",
              "label": "Image Force Full Width",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "full_width": "off"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "mask": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "size": {
              "groupSlug": "mask_settings",
              "render": true,
              "priority": "0",
              "subName": "size",
              "label": "Mask Size",
              "features": {
                "sticky": false,
                "hover": false
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "size": "80"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    "%"
                  ],
                  "defaultUnit": "%",
                  "min": 1,
                  "max": 100,
                  "maxLimit": 100,
                  "minLimit": 1,
                  "step": 1
                }
              }
            },
            "position": {
              "groupSlug": "mask_settings",
              "render": true,
              "subName": "position",
              "label": "Mask Position",
              "priority": "1",
              "features": {
                "sticky": false,
                "hover": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "position": "center"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "top left": {
                      "label": "Top Left"
                    },
                    "top center": {
                      "label": "Top Center"
                    },
                    "top right": {
                      "label": "Top Right"
                    },
                    "center left": {
                      "label": "Center Left"
                    },
                    "center": {
                      "label": "Center"
                    },
                    "center right": {
                      "label": "Center Right"
                    },
                    "bottom left": {
                      "label": "Bottom Left"
                    },
                    "bottom center": {
                      "label": "Bottom Center"
                    },
                    "bottom right": {
                      "label": "Bottom Right"
                    }
                  }
                }
              }
            },
            "select": {
              "groupSlug": "mask_settings",
              "render": true,
              "subName": "select",
              "label": "Select Mask",
              "priority": "2",
              "features": {
                "sticky": false,
                "hover": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "select": "mask_image_01"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "mask_image_01": {
                      "label": "Mask 1"
                    },
                    "mask_image_02": {
                      "label": "Mask 2"
                    },
                    "mask_image_03": {
                      "label": "Mask 3"
                    },
                    "mask_image_04": {
                      "label": "Mask 4"
                    },
                    "mask_image_05": {
                      "label": "Mask 5"
                    },
                    "mask_image_06": {
                      "label": "Mask 6"
                    },
                    "mask_image_07": {
                      "label": "Mask 7"
                    },
                    "mask_image_08": {
                      "label": "Mask 8"
                    },
                    "mask_image_09": {
                      "label": "Mask 9"
                    },
                    "mask_image_10": {
                      "label": "Mask 10"
                    },
                    "mask_image_11": {
                      "label": "Mask 11"
                    },
                    "mask_image_12": {
                      "label": "Mask 12"
                    },
                    "mask_image_13": {
                      "label": "Mask 13"
                    },
                    "mask_image_14": {
                      "label": "Mask 14"
                    },
                    "mask_image_15": {
                      "label": "Mask 15"
                    },
                    "mask_image_16": {
                      "label": "Mask 16"
                    },
                    "mask_image_17": {
                      "label": "Mask 17"
                    },
                    "mask_image_18": {
                      "label": "Mask 18"
                    },
                    "mask_image_19": {
                      "label": "Mask 19"
                    },
                    "mask_image_20": {
                      "label": "Mask 20"
                    },
                    "mask_image_21": {
                      "label": "Mask 21"
                    },
                    "mask_image_22": {
                      "label": "Mask 22"
                    },
                    "mask_image_23": {
                      "label": "Mask 23"
                    },
                    "mask_image_24": {
                      "label": "Mask 24"
                    },
                    "mask_image_25": {
                      "label": "Mask 25"
                    },
                    "mask_image_26": {
                      "label": "Mask 26"
                    },
                    "mask_image_27": {
                      "label": "Mask 27"
                    },
                    "mask_image_28": {
                      "label": "Mask 28"
                    },
                    "mask_image_29": {
                      "label": "Mask 29"
                    },
                    "mask_image_30": {
                      "label": "Mask 30"
                    }
                  }
                }
              }
            },
            "rotate": {
              "groupSlug": "mask_settings",
              "render": true,
              "subName": "rotate",
              "label": "Rotate",
              "priority": "4",
              "features": {
                "sticky": false,
                "hover": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    "deg"
                  ],
                  "defaultUnit": "deg",
                  "min": 0,
                  "max": 360,
                  "minLimit": 0,
                  "maxLimit": 360,
                  "step": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
