{
  "name": "difl/logocarouselitem",
  "d4Shortcode": "difl_logocarouselitem",
  "title": "Logo Carousel Item",
  "titles": "Logo Carousel Items",
  "category": "child-module",
  "parentsName": [
    "difl/logocarousel"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "image": {
        "panel": "content",
        "groupName": "image",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "contentLink",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "interactions": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "styleProps": {
        "styleProps": {
          "border": {
            "selectors": {
              "desktop": {
                "value": "{{baseSelector}} .difl_logocarouselitem.difl_logocarouselitem",
                "hover": "{{baseSelector}} .difl_logocarouselitem.difl_logocarouselitem:hover",
                "important": "all"
              }
            }
          }
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Logo Carousel Item"
            }
          }
        }
      }
    },
    "logo_image": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "image": {
              "groupSlug": "image",
              "attrName": "logo_image.innerContent",
              "subName": "image",
              "label": "Image",
              "description": "Upload an image.",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "image"
                },
                "sticky": false,
                "responsive": true,
                "hover": true,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": "image",
                    "id": true,
                    "alt": true,
                    "titleText": true
                  }
                }
              }
            },
            "alt_text": {
              "groupSlug": "image",
              "attrName": "logo_image.innerContent",
              "subName": "alt_text",
              "label": "Image Alt Text",
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "sticky": false,
                "responsive": false,
                "hover": false,
                "preset": "content"
              },
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        }
      }
    }
  }
}