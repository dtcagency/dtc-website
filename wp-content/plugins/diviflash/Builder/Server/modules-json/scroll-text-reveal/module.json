{
  "name": "difl/text-reveal",
  "d4Shortcode": "difl_text_reveal",
  "title": "Scroll Text Reveal",
  "titles": "Scroll Text Reveals",
  "category": "module",
  "moduleIcon": "difl/scroll-text-reveal",
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "toggle_key__content": {
        "panel": "content",
        "groupName": "toggle_key__content",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text"
          }
        }
      },
      "toggle_key__reveal_settings": {
        "panel": "content",
        "groupName": "toggle_key__reveal_settings",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Reveal Settings"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "link",
        "priority": 100,
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link",
            "preset": "content"
          }
        }
      },
      "text": {
        "panel": "design",
        "groupName": "text",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text"
          }
        }
      },
      "header": {
        "panel": "design",
        "groupName": "header",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Heading Text"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {
          "link": {
            "item": {
              "groupSlug": "contentLink",
              "component": {
                "props": {
                  "fieldLabel": ""
                }
              }
            }
          }
        },
        "decoration": {
          "attributes": {},
          "background": {
            "component": {
              "type": "group",
              "name": "divi/background",
              "props": {
                "hidePanels": [
                  "video",
                  "pattern",
                  "mask"
                ]
              }
            }
          },
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "conditions": {},
          "interactions": {},
          "disabledOn": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "sticky": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Scroll Text Reveal"
            }
          }
        },
        "decoration": {
          "background": {
            "desktop": {
              "value": {
                "image": {
                  "size": "cover",
                  "position": "center"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "boxShadow": {
          "selectors": {
            "desktop": {
              "value": "{{selector}}"
            }
          }
        },
        "spacing": {
          "important": true,
          "selectors": {
            "desktop": {
              "value": "{{selector}}"
            }
          }
        }
      }
    },
    "reveal_obj_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "inlineEditor": true,
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "settings__trigger_type": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__trigger_type",
              "label": "Trigger Type",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__trigger_type": "with-scroll"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "auto": {
                      "label": "Auto"
                    },
                    "with-scroll": {
                      "label": "With Scroll"
                    },
                    "on-viewport": {
                      "label": "On Viewport"
                    }
                  }
                }
              }
            },
            "settings__split_content": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__split_content",
              "label": "Split Content",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__split_content": "df_text_reveal_letter_by_letter"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "df_text_reveal_letter_by_letter": {
                      "label": "Letter By Letter"
                    },
                    "df_text_reveal_word_by_word": {
                      "label": "Word By Word"
                    }
                  }
                }
              }
            },
            "settings__reveal_by": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_by",
              "label": "Reveal By",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__reveal_by": "df_text_reveal_by_opacity_animationr"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "df_text_reveal_by_opacity_animationr": {
                      "label": "Opacity Animation"
                    },
                    "df_text_reveal_by__dual_color_animation": {
                      "label": "Dual Color"
                    }
                  }
                }
              }
            },
            "settings__reveal_color": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_color",
              "label": "Reveal color",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__reveal_color": "#0038f0"
                  }
                }
              },
              "displayCondition": {
                "show_if": {
                  "settings__reveal_by": "df_text_reveal_by__dual_color_animation"
                }
              },
              "customCssAttr": {
                "selectors": {
                  "selector": "{{selector}} .df_text_reveal_main_container",
                  "hover": "{{selector}} .df_text_reveal_main_container"
                },
                "css_type": " --secondary-reveal-color",
                "important": true
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            },
            "settings__reveal_duration": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_duration",
              "label": "Animation Duration (ms)",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__reveal_duration": "1000"
                  }
                }
              },
              "displayCondition": {
                "show_if": {
                  "settings__trigger_type": [
                    "auto",
                    "on-viewport"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    ""
                  ],
                  "defaultUnit": "",
                  "minLimit": 0,
                  "maxLimit": 10000,
                  "step": 1
                }
              }
            },
            "settings__reveal_delay": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_delay",
              "label": "Animation Delay (ms)",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "displayCondition": {
                "show_if": {
                  "settings__trigger_type": [
                    "auto",
                    "on-viewport"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    ""
                  ],
                  "defaultUnit": "",
                  "minLimit": 0,
                  "maxLimit": 10000,
                  "step": 1
                }
              }
            },
            "settings__reveal_initial_opacity": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_initial_opacity",
              "label": "Initial Opacity",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__reveal_initial_opacity": 0.2
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0.1,
                  "max": 0.9,
                  "minLimit": 0.1,
                  "maxLimit": 0.9,
                  "allowedUnits": [
                    ""
                  ],
                  "defaultUnit": "",
                  "step": 0.01
                }
              }
            },
            "settings__reveal_viewport_offset_value_top": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_viewport_offset_value_top",
              "label": "Viewport offset top",
              "description": "Unit in percentage,value calculate from viewport bottom ",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "displayCondition": {
                "show_if": {
                  "settings__trigger_type": [
                    "on-viewport",
                    "with-scroll"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    "%",
                    "px"
                  ],
                  "defaultUnit": "%",
                  "minLimit": 0,
                  "max": 100,
                  "step": 1
                }
              }
            },
            "settings__reveal_viewport_offset_value_bottom": {
              "groupSlug": "toggle_key__reveal_settings",
              "render": true,
              "subName": "settings__reveal_viewport_offset_value_bottom",
              "label": "Viewport offset Bottom",
              "description": "Unit in percentage,value calculate from viewport bottom ",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "displayCondition": {
                "show_if": {
                  "settings__trigger_type": [
                    "on-viewport",
                    "with-scroll"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    "%",
                    "px"
                  ],
                  "defaultUnit": "%",
                  "minLimit": 0,
                  "max": 100,
                  "step": 1
                }
              }
            }
          }
        }
      }
    },
    "content_obj_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "inlineEditor": true,
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "settings__content": {
              "groupSlug": "toggle_key__content",
              "render": true,
              "subName": "settings__content",
              "label": "Text",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content",
                "dynamicContent": {
                  "type": "text"
                }
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "settings__content": "Your content goes here. Edit or remove this text inline or in the module Content settings. You can also style every aspect of this content in the module Design settings and even apply custom CSS to this text in the module Advanced settings."
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/richtext"
              }
            }
          }
        },
        "decoration": {
          "headingFont": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "header",
              "render": true,
              "label": "Heading",
              "features": {
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "group",
                "name": "divi/font-header",
                "props": {
                  "grouped": false,
                  "defaultGroupAttr": {
                    "h1": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "30px"
                          }
                        }
                      }
                    },
                    "h2": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "26px"
                          }
                        }
                      }
                    },
                    "h3": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "22px"
                          }
                        }
                      }
                    },
                    "h4": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "18px"
                          }
                        }
                      }
                    },
                    "h5": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "16px"
                          }
                        }
                      }
                    },
                    "h6": {
                      "font": {
                        "desktop": {
                          "value": {
                            "size": "14px"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "bodyFont": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "text",
              "render": true,
              "label": "Text",
              "features": {
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "group",
                "name": "divi/font-body",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      }
    }
  }
}
