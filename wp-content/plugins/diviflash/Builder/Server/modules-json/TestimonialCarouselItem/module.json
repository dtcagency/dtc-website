            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "attributes": {},
          "background": {},
