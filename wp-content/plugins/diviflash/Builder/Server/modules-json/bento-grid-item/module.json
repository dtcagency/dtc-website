{
  "name": "difl/bento-grid-item",
  "d4Shortcode": "",
  "title": "Bento Grid Item",
  "titles": "Bento Grid Item",
  "moduleClassName": "difl_bento_grid_item",
  "moduleOrderClassName": "difl_bento_grid_item",
  "category": "child-module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Bento Grid Item"
            }
          }
        }
      }
    },
    "title": {
      "type": "object",
      "selector": ".difl_bento_grid {{selector}} .difl_bento_grid_item__title",
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "tagName": "div",
      "attributes": {
        "class": "difl_bento_grid_item__title"
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "content": {
      "type": "object",
      "selector": ".difl_bento_grid {{selector}} .difl_bento_grid_item__content",
      "tagName": "div",
      "attributes": {
        "class": "difl_bento_grid_item__content"
      },
      "inlineEditor": "richText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "icon": {
      "type": "object",
      "selector": "{{selector}} .difl_bento_grid_item__icon.et-pb-icon"
    },
    "image" : {
      "type": "object",
      "selector": "{{selector}} img",
      "elementType": "element",
      "features": {
        "responsive": false,
        "hover": false,
        "sticky": false,
        "preset": "content"
      },
      "render": true,
      "priority": 10,
      "component": {
        "type": "field",
        "name": "divi/upload-gallery"
      }
    },
    "image_size": {
      "type": "object",
      "selector": "{{selector}} .difl_bento_grid_item__image img",
      "innerContent": {},
      "default" : {
        "decoration": {
          "size": {
            "desktop": {
              "value": "90px"
            }
          }
        }
      }
    },
    "imageStyle": {
      "type": "object",
      "selector": "{{selector}} .difl_bento_grid_item__image img",
      "decoration": {
        "border": {},
        "boxShadow": {}
      }
    },
    "gridLayout": {
      "type": "object",
      "innerContent": {},
      "default" : {
        "decoration": {
          "desktop": {
            "value": {
              "rowSpan": "2",
              "columnSpan": "2"
            }
          }
        }
      }
    },
    "gridLayoutField": {
      "type": "object",
      "innerContent": {},
      "default" : {
        "decoration": {
          "desktop": {
            "value": {
              "row": "2",
              "column": "2"
            }
          }
        }
      }
    },
    "imageIcon": {
      "type": "object",
      "selector": "{{selector}} img",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "useIcon": {
              "groupSlug": "contentImageIcon",
              "attrName": "imageIcon.innerContent",
              "subName": "useIcon",
              "label": "Use Icon",
              "description": "Here you can choose whether icon set below should be used.",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "icon": {},
            "src": {},
            "alt": {},
            "animation": {}
          }
        },
        "advanced": {},
        "decoration": {}
      }
    },
    "button": {
      "type": "object",
      "selector": ".difl_bento_grid {{selector}} .difl_bento_grid_item__button_wrapper .difl_bento_grid_item__button",
      "elementType": "button"
    }
  },
  "customCssFields": {
    "contentContainer": {
      "subName": "contentContainer",
      "selectorSuffix": " .difl_bento_grid_item__content-container"
    },
    "title": {
      "subName": "title",
      "selectorSuffix": " .difl_bento_grid_item__title"
    },
    "content": {
      "subName": "content",
      "selectorSuffix": " .difl_bento_grid_item__content"
    },
    "icon": {
      "subName": "icon",
      "selectorSuffix": " .difl_bento_grid_item__icon.et-pb-icon"
    }
  },
  "settings": {
    "groups": {
      "contentImageIcon": {
        "panel": "content",
        "priority": 20,
        "groupName": "imageIcon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image & Icon"
          }
        }
      }
    }
  }
}