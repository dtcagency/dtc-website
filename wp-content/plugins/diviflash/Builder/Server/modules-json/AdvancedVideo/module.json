    "source_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "source_type": {
              "groupSlug": "video_source",
              "attrName": "source_settings.innerContent",
              "subName": "source_type",
              "label": "Source",
              "render": true,
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "source_type": "youtube"
                  }
                }
              },
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "youtube": { "label": "YouTube" },
                    "vimeo": { "label": "Vimeo" },
                    "dailymotion": { "label": "Dailymotion" },
                    "videopress": { "label": "VideoPress" },
                    "self_hosted": { "label": "Self Hosted" }
