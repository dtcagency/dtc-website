    "tilt_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "tc_reverse": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_reverse",
              "label": "Reverse the tilt direction",
              "render": true,
              "description": "Setting this option will reverse the tilt.",
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "tc_max": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_max",
              "label": "Max tilt rotation (degrees)",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 1,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "tc_perspective": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_perspective",
              "label": "Transform perspective",
              "render": true,
              "description": "Transform perspective, the lower the more extreme the tilt gets.",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 100,
                  "max": 2000,
                  "step": 50,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "tc_glare": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_glare",
              "label": "Glare",
              "render": true,
              "description": "Setting this option will enable a glare effect.",
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "tc_glare_opacity": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_glare_opacity",
              "label": "Glare Opacity",
              "render": true,
              "show_if": {
                "tc_glare": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0.1,
                  "max": 1,
                  "step": 0.1,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "tc_card_scale": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_card_scale",
              "label": "Card Scale on hover",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0.1,
                  "max": 3,
                  "step": 0.1,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "tc_speed": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_speed",
              "label": "Speed",
              "render": true,
              "description": "Speed of the enter/exit transition",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 100,
                  "max": 5000,
                  "step": 50,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "tc_full_page": {
              "groupSlug": "tilt",
              "attrName": "tilt_settings.innerContent",
              "subName": "tc_full_page",
              "label": "Full page listening",
              "render": true,
              "description": "Setting this option will make the element respond to any mouse movements on page.",
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "tc_reverse": "off",
              "tc_max": "35",
              "tc_perspective": "1000",
              "tc_glare": "off",
              "tc_glare_opacity": "1",
              "tc_card_scale": "1",
              "tc_speed": "300",
              "tc_full_page": "off"
            }
          }
        }
      }
    },
    "content_float": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
