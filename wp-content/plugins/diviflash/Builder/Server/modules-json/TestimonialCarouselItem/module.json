        "innerContent": {
          "groupType": "group-items",
          "items": {
            "author": {
              "groupSlug": "content",
              "attrName": "item_content.innerContent",
              "subName": "author",
              "label": "Author",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "job_title": {
              "groupSlug": "content",
              "attrName": "item_content.innerContent",
              "subName": "job_title",
              "label": "Job Title",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "company": {
              "groupSlug": "content",
              "attrName": "item_content.innerContent",
              "subName": "company",
              "label": "Company",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "company_url": {
              "groupSlug": "content",
              "attrName": "item_content.innerContent",
              "subName": "company_url",
              "label": "Company Url",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "url"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "content": {
              "groupSlug": "content",
              "attrName": "item_content.innerContent",
              "subName": "content",
              "label": "Body",
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/richtext"
              }
            }
          }
        }
      }
    },
    "item_images": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "author_image": {
              "groupSlug": "images",
              "attrName": "item_images.innerContent",
              "subName": "author_image",
              "label": "Author Image",
              "render": true,
              "features": {
                "responsive": false,
                "preset": "content",
                "dynamicContent": {
                  "type": "image"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": "author_image",
                    "id": false,
                    "alt": false,
                    "titleText": false,
                    "width": false,
                    "height": false
                  }
                }
              }
            },
            "author_image_alt_text": {
              "groupSlug": "images",
              "attrName": "item_images.innerContent",
              "subName": "author_image_alt_text",
              "label": "Author Image Alt Text",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "company_logo": {
              "groupSlug": "images",
              "attrName": "item_images.innerContent",
              "subName": "company_logo",
              "label": "Company Logo",
              "render": true,
