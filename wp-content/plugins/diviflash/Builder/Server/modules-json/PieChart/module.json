    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "contentElements": {
                "panel": "content",
                "priority": 5,
                "groupName": "contentElements",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Slices"
                    }
                }
            },
            "data_source": {
                "panel": "content",
                "priority": 7,
                "groupName": "data_source",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Data Source"
                    }
                }
            },
            "general_settings": {
                "panel": "content",
                "priority": 10,
                "groupName": "general_settings",
                "multiElements": true,
                "component": {
