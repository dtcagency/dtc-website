{
  "name": "difl/floatimage",
  "d4Shortcode": "difl_floatimage",
  "title": "Floating Images",
  "category": "module",
  "childModuleName": "difl/floatimageitem",
  "childModuleTitle": "Floating Image Item",
  "childrenName": [
    "difl/floatimageitem"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "fi_settings": {
        "panel": "content",
        "groupName": "fi_settings",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image Settings"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "contentLink",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      },
      "image_shadow": {
        "panel": "design",
        "groupName": "image_shadow",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image Shadow"
          }
        }
      },
      "image_border": {
        "panel": "design",
        "groupName": "image_border",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image border"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "interactions": {},
          "conditions": {},
          "disabledOn": {},
          "overflow": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transition": {}
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Floating Images"
            }
          }
        }
      }
    },
    "fi_min_height": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fi_settings",
            "attrName": "fi_min_height.innerContent",
            "label": "Container Min Height",
            "render": true,
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "cssProperty": "max-height",
                "min": 1,
                "max": 2000,
                "step": 1,
                "minLimit": 1,
                "maxLimit": 2000
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "500px"
          }
        }
      }
    },
    "default": {
      "type": "object",
      "settings": {
        "decoration": {
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "attrName": "default.decoration.boxShadow",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "settings": {
        "decoration": {
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image_shadow",
              "attrName": "iamge.decoration.boxShadow",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": false
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image_border",
              "attrName": "image.decoration.border",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "boxShadow": {
          "selector": "{{selector}} .df_fii_container"
        },
        "border": {
          "selector": "{{selector}} .df_fii_container img"
        }
      }
    }
  }
}
