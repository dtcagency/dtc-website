{
  "name": "difl/circleinfoitem",
  "d4Shortcode": "difl_circleinfoitem",
  "title": "Interactive Circle Item",
  "titles": "Interactive Circle Items",
  "category": "child-module",
  "parentsName": [
    "difl/circleinfo"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "supportsCustomAttributes": true,
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label",
              "props": {
                "groupLabel": "Meta"
              }
            }
          }
        },
        "advanced": {
          "elements": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "priority": 5,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/elements",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "conditions": {},
          "disabledOn": {},
          "border": {},
          "boxShadow": {},
          "overflow": {},
          "position": {},
          "transform": {},
          "interactions": {},
          "transition": {},
          "scroll": {},
          "sticky": {},
          "zIndex": {}
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Interactive Circle Item"
            }
          }
        }
      }
    },
    "item_content": {
      "type": "object",
      "selector": "",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "title": {
              "groupSlug": "item_content",
              "render": true,
              "attrName": "item_content.innerContent",
              "subName": "title",
              "label": "Title",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "description": {
              "groupSlug": "item_content",
              "render": true,
              "attrName": "item_content.innerContent",
              "subName": "description",
              "label": "Description",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "text"
                },
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/richtext"
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "title": "Item Title",
              "description": "Item description goes here."
            }
          }
        }
      }
    },
    "item_icon_content": {
      "type": "object",
      "selector": "",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "icon_type": {
              "groupSlug": "item_icon_settings",
              "render": true,
              "attrName": "item_icon_content.innerContent",
              "subName": "icon_type",
              "label": "Icon Type",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "none": {
                      "label": "None"
                    },
                    "icon": {
                      "label": "Icon"
                    },
                    "image": {
                      "label": "Image"
                    }
                  }
                }
              }
            },
            "font_icon": {
              "groupSlug": "item_icon_settings",
              "attrName": "item_icon_content.innerContent",
              "subName": "font_icon",
              "label": "Icon",
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/icon-picker"
              },
              "show_if": {
                "icon_type": "icon"
              }
            },
            "icon_image": {
              "groupSlug": "item_icon_settings",
              "attrName": "item_icon_content.innerContent",
              "subName": "icon_image",
              "label": "Icon Image",
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": "icon_image",
                    "id": true,
                    "alt": true,
                    "titleText": true
                  }
                }
              },
              "show_if": {
                "icon_type": "image"
              }
            },
            "icon_text": {
              "groupSlug": "item_icon_settings",
              "attrName": "item_icon_content.innerContent",
              "subName": "icon_text",
              "label": "Text",
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/text",
                "props": {
                  "placeholder": "01"
                }
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "icon_type": "icon"
            }
          }
        }
      }
    },
    "item_icon_override_settings": {
      "type": "object",
      "selector": "",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "override_icon_style": {
              "groupSlug": "item_icon_override",
              "render": true,
              "attrName": "item_icon_override_settings.innerContent",
              "subName": "override_icon_style",
              "label": "Override Parent Style",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "custom_icon_color": {
              "groupSlug": "item_icon_override",
              "attrName": "item_icon_override_settings.innerContent",
              "subName": "custom_icon_color",
              "label": "Icon Color",
              "render": true,
              "features": {
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "color"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker",
                "props": {}
              },
              "show_if": {
                "override_icon_style": "on"
              }
            },
            "custom_icon_bg_color": {
              "groupSlug": "item_icon_override",
              "attrName": "item_icon_override_settings.innerContent",
              "subName": "custom_icon_bg_color",
              "label": "Icon Background",
              "render": true,
              "features": {
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "color"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker",
                "props": {}
              },
              "show_if": {
                "override_icon_style": "on"
              }
            },
            "custom_active_icon_color": {
              "groupSlug": "item_icon_override",
              "attrName": "item_icon_override_settings.innerContent",
              "subName": "custom_active_icon_color",
              "label": "Active Icon Color",
              "render": true,
              "features": {
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "color"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker",
                "props": {}
              },
              "show_if": {
                "override_icon_style": "on"
              }
            },
            "custom_active_icon_bg_color": {
              "groupSlug": "item_icon_override",
              "attrName": "item_icon_override_settings.innerContent",
              "subName": "custom_active_icon_bg_color",
              "label": "Active Icon Background",
              "render": true,
              "features": {
                "sticky": false,
                "responsive": false,
                "dynamicContent": {
                  "type": "color"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker",
                "props": {}
              },
              "show_if": {
                "override_icon_style": "on"
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "override_icon_style": "off"
            }
          }
        }
      }
    },
    "item_background": {
      "type": "object",
      "selector": "{{selector}}.df_ci_center_content",
      "settings": {
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "item_background_design",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": false,
                  "hidePanels": [
                    "video",
                    "mask",
                    "pattern"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "item_title": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "font": {
          "selectors": {
            "desktop": {
              "value": ".df_circle_info_center {{selector}} .df_ci_title"
            }
          },
          "important": {
            "desktop": {
              "value": true
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "item_title_design",
              "label": "Title",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Title",
                  "fields": {
                    "headingLevel": {
                      "render": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "item_description": {
      "type": "object",
      "selector": ".df_circle_info_center {{selector}} .df_ci_description",
      "styleProps": {
        "bodyFont": {
          "selectors": {
            "desktop": {
              "value": ".df_circle_info_center {{selector}} .df_ci_description"
            }
          },
          "important": {
            "desktop": {
              "value": true
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "bodyFont": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "item_description_design",
              "label": "Description",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font-body",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "item_content": {
        "panel": "content",
        "priority": 1,
        "groupName": "item_content",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "item_icon_settings": {
        "panel": "content",
        "priority": 2,
        "groupName": "item_icon_settings",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Anchor"
          }
        }
      },
      "item_background_design": {
        "panel": "design",
        "groupName": "item_background_design",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Center Area Background"
          }
        }
      },
      "item_icon_override": {
        "panel": "design",
        "groupName": "item_icon_override",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Icon Override"
          }
        }
      },
      "item_title_design": {
        "panel": "design",
        "groupName": "item_title_design",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Title"
          }
        }
      },
      "item_description_design": {
        "panel": "design",
        "groupName": "item_description_design",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Description"
          }
        }
      },
      "contentElements": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentElements",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      }
    }
  },
  "childrenName": [],
  "allowAllElements": true
}