{
    "name": "difl/piechart",
    "d4Shortcode": "difl_piechart",
    "title": "Pie Chart",
    "titles": "Pie Charts",
    "category": "module",
    "moduleIcon": "difl/piechart",
    "childModuleName": "difl/piechartitem",
    "childModuleTitle": "Pie Chart Item",
    "childModuleTitleAttribute": "slice_label",
    "childrenName": ["difl/piechartitem"],
    "allowAllElements": false,
    "customCssFields": {
        "chart_wrapper": {
            "subName": "chart_wrapper",
            "label": "Chart Wrapper",
            "selectorSuffix": " .df_pie_chart_wrapper"
        },
        "chart_canvas": {
            "subName": "chart_canvas",
            "label": "Chart Canvas",
            "selectorSuffix": " .df_pie_chart_canvas"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label",
                            "props": { "groupLabel": "Meta" }
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink"
                        }
                    }
                },
                "decoration": {
                    "attributes": {},
                    "background": {},
                    "spacing": {},
                    "border": {},
                    "boxShadow": {},
                    "sizing": {},
                    "scroll": {},
                    "overflow": {},
                    "filters": {},
                    "transform": {},
                    "animation": {},
                    "position": {},
                    "sticky": {},
                    "zIndex": {},
                    "conditions": {},
                    "disabledOn": {},
                    "transition": {},
                    "interactions": {}
                }
            },
            "styleProps": {
                "spacing": { "important": true }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Pie Chart"
                        }
                    }
                }
            }
        },
        "data_source": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "data_source": {
                            "groupSlug": "data_source",
                            "attrName": "data_source.innerContent",
                            "subName": "data_source",
                            "label": "Data Source",
                            "description": "Where slice data comes from. Manual uses the items below; URL options fetch and parse a remote file (first dataset is used for pie slices).",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "manual": { "label": "Manual" },
                                        "google_sheets": { "label": "Google Sheets (CSV)" },
                                        "csv_url": { "label": "CSV URL" },
                                        "json_url": { "label": "JSON URL" }
                                    }
                                }
                            }
                        },
                        "sheets_url": {
                            "groupSlug": "data_source",
                            "attrName": "data_source.innerContent",
                            "subName": "sheets_url",
                            "label": "Google Sheets URL",
                            "description": "In Google Sheets: File → Share → Publish to web → Publish, then paste the URL here. Standard edit/share URLs also work if the sheet is set to \"Anyone with the link → Viewer\".",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "show_if": { "data_source": "google_sheets" },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "https://docs.google.com/spreadsheets/d/.../edit?usp=sharing"
                                }
                            }
                        },
                        "csv_source_url": {
                            "groupSlug": "data_source",
                            "attrName": "data_source.innerContent",
                            "subName": "csv_source_url",
                            "label": "CSV URL",
                            "description": "Public URL of a CSV file. First row is the header (label column + value column); only the first value column is used for pie slices.",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "show_if": { "data_source": "csv_url" },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "https://example.com/data.csv"
                                }
                            }
                        },
                        "json_source_url": {
                            "groupSlug": "data_source",
                            "attrName": "data_source.innerContent",
                            "subName": "json_source_url",
                            "label": "JSON URL",
                            "description": "Public URL returning JSON in one of two shapes. Shape A: {\"labels\":[\"Chrome\",\"Safari\"],\"datasets\":[{\"values\":[45,25]}]}. Shape B: array of row objects, first key in each row becomes the slice label — [{\"Browser\":\"Chrome\",\"Share\":45}, {\"Browser\":\"Safari\",\"Share\":25}].",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "show_if": { "data_source": "json_url" },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "https://example.com/data.json"
                                }
                            }
                        },
                        "cache_ttl": {
                            "groupSlug": "data_source",
                            "attrName": "data_source.innerContent",
                            "subName": "cache_ttl",
                            "label": "Cache Duration",
                            "description": "How long the fetched data is cached on the server before refetching.",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "show_if_not": { "data_source": "manual" },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "3600":  { "label": "1 hour" },
                                        "21600": { "label": "6 hours" },
                                        "86400": { "label": "1 day" },
                                        "0":     { "label": "Never (fetch every page load)" }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "data_source": "manual",
                            "sheets_url": "",
                            "csv_source_url": "",
                            "json_source_url": "",
                            "cache_ttl": "3600"
                        }
                    }
                }
            }
        },
        "chart_settings": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "chart_title": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "chart_title",
                            "label": "Chart Title",
                            "description": "Optional title displayed above the chart.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "My Chart"
                                }
                            }
                        },
                        "title_position": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "title_position",
                            "label": "Title Position",
                            "description": "Position of the title relative to the chart area.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "top": { "label": "Top" },
                                        "right": { "label": "Right" },
                                        "bottom": { "label": "Bottom" },
                                        "left": { "label": "Left" }
                                    }
                                }
                            }
                        },
                        "chart_variant": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "chart_variant",
                            "label": "Chart Type",
                            "description": "Choose between pie and doughnut chart.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "pie": { "label": "Pie" },
                                        "doughnut": { "label": "Doughnut" }
                                    }
                                }
                            }
                        },
                        "cutout_percentage": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "cutout_percentage",
                            "label": "Cutout Percentage",
                            "description": "Size of the hole in the center for doughnut charts (0–90%).",
                            "render": true,
                            "show_if": { "chart_variant": "doughnut" },
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "allowedUnits": [""],
                                    "defaultUnit": ""
                                }
                            }
                        },
                        "border_width": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "border_width",
                            "label": "Border Width",
                            "description": "Width of the border between slices in pixels.",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "unitless": true
                                }
                            }
                        },
                        "border_color": {
                            "groupSlug": "general_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "border_color",
                            "label": "Border Color",
                            "description": "Color of the border between slices.",
                            "render": true,
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "show_legend": {
                            "groupSlug": "legend_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "show_legend",
                            "label": "Show Legend",
                            "description": "Display the legend showing slice names and colors.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        },
                        "legend_position": {
                            "groupSlug": "legend_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "legend_position",
                            "label": "Legend Position",
                            "description": "Position of the legend relative to the chart area.",
                            "render": true,
                            "show_if": { "show_legend": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "top": { "label": "Top" },
                                        "right": { "label": "Right" },
                                        "bottom": { "label": "Bottom" },
                                        "left": { "label": "Left" }
                                    }
                                }
                            }
                        },
                        "legend_align": {
                            "groupSlug": "legend_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "legend_align",
                            "label": "Legend Alignment",
                            "description": "Horizontal alignment of the legend text.",
                            "render": true,
                            "show_if": { "show_legend": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "start": { "label": "Start" },
                                        "center": { "label": "Center" },
                                        "end": { "label": "End" }
                                    }
                                }
                            }
                        },
                        "show_tooltip": {
                            "groupSlug": "tooltip_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "show_tooltip",
                            "label": "Show Tooltip",
                            "description": "Display a tooltip when hovering over a slice.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        },
                        "value_prefix": {
                            "groupSlug": "tooltip_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "value_prefix",
                            "label": "Value Prefix",
                            "description": "Prefix for values (e.g. $, \u20ac).",
                            "render": true,
                            "show_if": { "show_tooltip": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "$"
                                }
                            }
                        },
                        "value_suffix": {
                            "groupSlug": "tooltip_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "value_suffix",
                            "label": "Value Suffix",
                            "description": "Suffix for values (e.g. %, k).",
                            "render": true,
                            "show_if": { "show_tooltip": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "%"
                                }
                            }
                        },
                        "show_percentage": {
                            "groupSlug": "tooltip_settings",
                            "attrName": "chart_settings.innerContent",
                            "subName": "show_percentage",
                            "label": "Show Percentage",
                            "description": "Display percentage in tooltip alongside the value.",
                            "render": true,
                            "show_if": { "show_tooltip": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "chart_title": "",
                            "title_position": "top",
                            "chart_variant": "pie",
                            "cutout_percentage": "50",
                            "border_width": "2",
                            "border_color": "#ffffff",
                            "show_legend": "on",
                            "legend_position": "top",
                            "legend_align": "center",
                            "show_tooltip": "on",
                            "value_prefix": "",
                            "value_suffix": "",
                            "show_percentage": "off"
                        }
                    }
                }
            }
        },
        "pie_settings": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "chart_height": {
                            "groupSlug": "sizing_settings",
                            "attrName": "pie_settings.innerContent",
                            "subName": "chart_height",
                            "label": "Chart Height",
                            "description": "Height of the chart area in pixels.",
                            "render": true,
                            "features": { "responsive": true, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 200,
                                    "max": 1000,
                                    "step": 10,
                                    "unitless": true,
                                    "allowedUnits": [""],
                                    "defaultUnit": ""
                                }
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "chart_height": "400"
                        }
                    }
                }
            }
        },
        "animation_settings": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "enable_animation": {
                            "groupSlug": "animation_config",
                            "attrName": "animation_settings.innerContent",
                            "subName": "enable_animation",
                            "label": "Enable Animation",
                            "description": "Animate slices when the chart first renders.",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        },
                        "animation_duration": {
                            "groupSlug": "animation_config",
                            "attrName": "animation_settings.innerContent",
                            "subName": "animation_duration",
                            "label": "Animation Duration (ms)",
                            "description": "How long the animation takes in milliseconds.",
                            "render": true,
                            "show_if": { "enable_animation": "on" },
                            "features": { "responsive": false, "hover": false, "sticky": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 5000,
                                    "step": 100,
                                    "unitless": true,
                                    "allowedUnits": [""],
                                    "defaultUnit": ""
                                }
                            }
                        },
                        "animation_easing": {
                            "groupSlug": "animation_config",
                            "attrName": "animation_settings.innerContent",
                            "subName": "animation_easing",
                            "label": "Animation Easing",
                            "description": "The easing curve for the animation.",
                            "render": true,
                            "show_if": { "enable_animation": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "linear": { "label": "Linear" },
                                        "easeInQuad": { "label": "Ease In Quad" },
                                        "easeOutQuad": { "label": "Ease Out Quad" },
                                        "easeInOutQuad": { "label": "Ease In Out Quad" },
                                        "easeInCubic": { "label": "Ease In Cubic" },
                                        "easeOutCubic": { "label": "Ease Out Cubic" },
                                        "easeInOutCubic": { "label": "Ease In Out Cubic" },
                                        "easeOutQuart": { "label": "Ease Out Quart" },
                                        "easeOutBounce": { "label": "Ease Out Bounce" }
                                    }
                                }
                            }
                        },
                        "animate_on_scroll": {
                            "groupSlug": "animation_config",
                            "attrName": "animation_settings.innerContent",
                            "subName": "animate_on_scroll",
                            "label": "Animate on Scroll",
                            "description": "Trigger animation only when the chart scrolls into view.",
                            "render": true,
                            "show_if": { "enable_animation": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "enable_animation": "on",
                            "animation_duration": "1000",
                            "animation_easing": "easeOutQuart",
                            "animate_on_scroll": "on"
                        }
                    }
                }
            }
        },
        "title_font": {
            "type": "object",
            "selector": "",
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "chart_typography",
                            "priority": 10,
                            "attrName": "title_font.decoration.font",
                            "label": "Title",
                            "render": true,
                            "features": { "responsive": true, "hover": false, "sticky": false },
                            "component": {
                                "type": "group",
                                "name": "divi/font",
                                "props": {
                                    "grouped": true,
                                    "groupLabel": "Title",
                                    "fieldLabel": "Title",
                                    "fields": {
                                        "headingLevel": { "render": false },
                                        "style": { "render": false },
                                        "textAlign": { "render": false },
                                        "letterSpacing": { "render": false },
                                        "lineHeight": { "render": false },
                                        "lineColor": { "render": false },
                                        "lineStyle": { "render": false },
                                        "textShadowGroup": { "render": false },
                                        "family": { "features": { "hover": false } },
                                        "weight": { "features": { "hover": false } },
                                        "color": { "features": { "hover": false } },
                                        "size": { "features": { "hover": false } }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "font": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}} .df_pie_chart_wrapper canvas"
                        }
                    },
                    "important": true
                }
            }
        },
