    "row_obj_settings": {
      "type": "object",
      "selector": ".entry-content table.df_dt_content tr{{selector}} th.df_dt_table_body_column_cell,.entry-content table.df_dt_content tr{{selector}} td.df_dt_table_body_column_cell",
      "inlineEditor": true,
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "design_row",
              "attrName": "row_obj_settings.decoration.font",
              "label": "Row",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Row",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    }
                  }
                }
              }
            }
          },
          "background": {
            "groupType": "group-item",
            "item": {
              "priority": 0,
              "groupSlug": "design_row",
              "render": true,
              "label": "Row",
              "features": {
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": false,
                  "hidePanels": [
                    "video",
                    "mask",
                    "pattern",
                    "image"
                  ],
                  "fields": {
                    "image": {
                      "parallaxEnabled": {
                        "render": false
                      },
                      "parallaxMethod": {
                        "render": false
                      }
                    }
                  }
                }
              },
              "attrName": "row_obj_settings.decoration.background"
            }
          }
        },
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "enable_row_merge": {
              "groupSlug": "table_options",
              "render": true,
              "subName": "enable_row_merge",
              "label": "Enable Row Merge",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "enable_row_merge": "off"
                  }
                }
              },
              "displayCondition": {
                "show_if": {
                  "row_type": [
                    "body"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "body_row_span_item": {
              "groupSlug": "table_options",
              "render": true,
              "subName": "body_row_span_item",
              "label": "Merge Row Item",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "displayCondition": {
                "show_if": {
                  "enable_row_merge": "on",
                  "row_type": [
                    "body"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "body_row_span_item_value": {
              "groupSlug": "table_options",
              "render": true,
              "subName": "body_row_span_item_value",
              "label": "Merge Row Item Value",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "displayCondition": {
                "show_if": {
                  "enable_row_merge": "on",
                  "row_type": [
                    "body"
                  ]
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "row": {
              "groupSlug": "content",
              "render": true,
              "attrName": "row_obj_settings.innerContent",
              "subName": "row",
              "label": "Columns",
              "description": "To make Empty column, you can use html special character for space (&amp;ampnbsp;). To want use font you should Put Icon code in span tag and use class &quot;et-pb-icon&quot; (Example:   &amp;ltspan class=&quot;et-pb-icon&quot; &amp;gt icon code &amp;ltspan&amp;gt). You can find icons code from here &lt;a href=&quot;https://www.elegantthemes.com/blog/resources/elegant-icon-font&quot;&gt; font list &lt;/a&gt; and go &quot;Complete Set and Unicode Reference Guide&quot; section",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/code",
                "props": {
                  "mode": "html"
                }
              }
            },
            "row_type": {
              "groupSlug": "content",
              "render": true,
              "subName": "row_type",
              "label": "Row Type",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "row_type": "body"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "head": {
                      "label": "Head"
                    },
                    "foot": {
                      "label": "Foot"
                    },
                    "body": {
                      "label": "Body"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps":{
        "font":{
          "important": true
        }
      }
    },
