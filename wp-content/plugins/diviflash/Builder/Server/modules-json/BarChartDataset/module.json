{
    "name": "difl/barchartdataset",
    "d4Shortcode": "difl_barchartdataset",
    "title": "Bar Dataset",
    "titles": "Bar Datasets",
    "category": "child-module",
    "parentsName": [
        "difl/barchart"
    ],
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label",
                            "props": { "groupLabel": "Meta" }
                        }
                    }
                },
                "advanced": {
                    "htmlAttributes": {}
                },
                "decoration": {
                    "conditions": {},
                    "disabledOn": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Bar Dataset"
                        }
                    }
                }
            }
        },
        "dataset_settings": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "dataset_name": {
                            "groupSlug": "bar_content",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "dataset_name",
                            "label": "Dataset Name",
                            "description": "Group name for this bar's dataset/series (e.g. Revenue). Bars with the same dataset name are grouped into one series.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false,
                                "dynamicContent": {
                                    "type": "text"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "Dataset 1"
                                }
                            }
                        },
                        "bar_color": {
                            "groupSlug": "bar_colors",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "bar_color",
                            "label": "Bar Color",
                            "description": "Background color of this bar.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "bar_hover_color": {
                            "groupSlug": "bar_colors",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "bar_hover_color",
                            "label": "Bar Hover Color",
                            "description": "Background color of this bar on hover.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "border_color": {
                            "groupSlug": "bar_colors",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "border_color",
                            "label": "Border Color",
                            "description": "Color of the bar border outline.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "border_width": {
                            "groupSlug": "bar_colors",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "border_width",
                            "label": "Border Width",
                            "description": "Thickness of the bar border in pixels.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "unitless": true
                                }
                            }
                        },
                        "use_gradient": {
                            "groupSlug": "bar_gradient",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "use_gradient",
                            "label": "Use Gradient",
                            "description": "Apply a vertical gradient instead of a solid color.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        },
                        "gradient_top": {
                            "groupSlug": "bar_gradient",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "gradient_top",
                            "label": "Gradient Top Color",
                            "description": "Color at the top of the bar gradient.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "show_if": {
                                "use_gradient": "on"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "gradient_bottom": {
                            "groupSlug": "bar_gradient",
                            "render": true,
                            "attrName": "dataset_settings.innerContent",
                            "subName": "gradient_bottom",
                            "label": "Gradient Bottom Color",
                            "description": "Color at the bottom of the bar gradient.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false
                            },
                            "show_if": {
                                "use_gradient": "on"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "dataset_name": "Dataset 1",
                            "bar_color": "",
                            "bar_hover_color": "",
                            "border_color": "",
                            "border_width": "1",
                            "use_gradient": "off",
                            "gradient_top": "#3366cc",
                            "gradient_bottom": "#1a3366"
                        }
                    }
                }
            }
        },
        "dataset_values": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "bar_content",
                        "attrName": "dataset_values.innerContent",
                        "label": "Values",
                        "render": true,
                        "features": {
                            "responsive": false,
                            "hover": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/sortable-list"
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": [
                            {"dragID": "df_bd_1", "value": "25"},
                            {"dragID": "df_bd_2", "value": "50"},
                            {"dragID": "df_bd_3", "value": "75"}
                        ]
                    }
                }
            }
        }
    },
    "customCssFields": {},
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "bar_content": {
                "panel": "content",
                "groupName": "bar_content",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Bar Content"
                    }
                }
            },
            "bar_colors": {
                "panel": "design",
                "priority": 5,
                "groupName": "bar_colors",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Bar Style"
                    }
                }
            },
            "bar_gradient": {
                "panel": "design",
                "priority": 10,
                "groupName": "bar_gradient",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Gradient"
                    }
                }
            }
        }
    },
    "childrenName": [],
    "allowAllElements": false
}