    "font_style_tab": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "font_style",
            "tab_slug": "font_style_tab",
            "module_slug": "difl/testimonialcarouselitem",
            "tabs": {
              "name": {
                "label": "Name",
                "components": []
              },
              "title": {
                "label": "Title",
                "components": []
              },
              "company": {
                "label": "Company",
