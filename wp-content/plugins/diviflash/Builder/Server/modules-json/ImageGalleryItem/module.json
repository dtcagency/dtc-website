{
  "name": "difl/imagegalleryitem",
  "d4Shortcode": "difl_imagegalleryitem",
  "title": "Advanced Gallery Item",
  "titles": "Advanced Gallery Items",
  "category": "child-module",
  "parentsName": [
    "difl/imagegallery"
  ],
  "titleAttribute": "type",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {},
        "decoration": {
          "transition": {},
          "conditions": {},
          "interactions": {},
          "disabledOn": {},
          "overflow": {},
          "position": {},
          "sticky": {},
          "scroll": {},
          "zIndex": {}
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Gallery"
            }
          }
        }
      }
    },
    "gallery_title": {
      "type": "object",
      "selector": "",
      "inlineEditor": true,
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "gallery",
            "render": true,
            "attrName": "gallery_title.innerContent",
            "label": "Title",
            "features": {
              "sticky": false,
              "hover": false,
              "responsive": false,
              "preset": "content"
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        }
      }
    },
    "gallery_ids": {
      "type": "object",
      "selector": "",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "gallery",
            "render": true,
            "attrName": "gallery_ids.innerContent",
            "label": "Gallery Images",
            "description": "Choose images that you would like to appear in the image gallery.",
            "features": {
              "sticky": false,
              "hover": false,
              "responsive": false
            },
            "component": {
              "type": "field",
              "name": "divi/upload-gallery"
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "gallery": {
        "panel": "content",
        "groupName": "gallery",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Gallery"
          }
        }
      }
    }
  }
}