{
  "name": "difl/advancedmenu",
  "d4Shortcode": "difl_advancedmenu",
  "title": "Advanced Menu",
  "titles": "Advanced Menus",
  "category": "module",
  "moduleIcon": "difl/advanced-menu",
  "childModuleTitle": "Item",
  "childModuleName": "difl/advancedmenuitem",
  "childrenName": [
    "difl/advancedmenuitem"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "settings": {
        "panel": "content",
        "groupName": "settings",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Settings"
          }
        },
        "priority": 0
      },
      "builder_view": {
        "panel": "content",
        "groupName": "builder_view",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Builder View"
          }
        },
        "priority": 1
      },
      "top_row": {
        "panel": "design",
        "groupName": "top_row",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Top Row Settings"
          }
        },
        "priority": 2
      },
      "center_row": {
        "panel": "design",
        "groupName": "center_row",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Center Row Settings"
          }
        },
        "priority": 3
      },
      "bottom_row": {
        "panel": "design",
        "groupName": "bottom_row",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Bottom Row Settings"
          }
        },
        "priority": 4
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        },
        "advanced": {
          "link": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "sizing": {},
          "transform": {},
          "spacing": {},
          "transition": {},
          "zIndex": {},
          "sticky": {},
          "conditions": {},
          "scroll": {},
          "interactions": {},
          "position": {},
          "overflow": {},
          "disabledOn": {},
          "animation": {}
        },
        "conditions": {
          "interactions": {}
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Advanced Menu"
            }
          }
        }
      }
    },
    "top_row_obj_settings": {
      "type": "object",
      "selector": "{{selector}} .df-am-container .top-row",
      "inlineEditor": true,
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "trow_hide_on_sticky": {
              "groupSlug": "top_row",
              "render": true,
              "subName": "trow_hide_on_sticky",
              "label": "Hide When Sticky",
              "priority": 0,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "trow_hide_on_sticky": "off"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "top_row_inner_width": {
              "groupSlug": "top_row",
              "render": true,
              "subName": "top_row_inner_width",
              "label": "Inner Wrapper Max Width",
              "features": {
                "sticky": false,
                "hover": false
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "top_row_inner_width": "100%"
                  }
                }
              },
              "customCssAttr": {
                "selectors": {
                  "selector": "{{selector}} .df-am-container .top-row .row-inner"
                },
                "css_type": "max-width",
                "important": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "allowedUnits": [
                    "px",
                    "%",
                    "em",
                    "vh",
                    "vw"
                  ],
                  "defaultUnit": "%",
                  "min": 1,
                  "max": 100,
                  "step": 1
                }
              }
            }
          }
        },
        "decoration": {
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "top_row",
              "render": true,
              "label": " Padding",
              "features": {
                "sticky": false
              },
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": false,
                  "fieldLabel": " "
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "top_row",
              "attrName": "top_row.decoration.border",
              "label": "",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": false,
                  "fieldLabel": null
                }
              }
            }
          },
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "top_row",
              "priority": 1,
              "render": true,
              "label": "Row",
              "features": {
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": false,
                  "hidePanels": [
                    "video",
                    "mask",
                    "pattern"
                  ],
                  "fields": {
                    "image": {
                      "parallaxEnabled": {
                        "render": false
                      },
                      "parallaxMethod": {
                        "render": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "default": {
        "decoration": {
          "background": {
            "desktop": {
              "value": {
                "image": {
                  "size": "cover",
                  "position": "center"
                }
              }
            }
          }
        }
      }
    },
