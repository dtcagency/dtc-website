    "posts_obj_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "inlineEditor": true,
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "posts_number": {
              "groupSlug": "settings",
              "render": true,
              "subName": "posts_number",
              "label": "Post Count",
              "description": "Choose how much posts you would like to display per page.",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "posts_number": 10
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "post_display": {
              "groupSlug": "settings",
              "render": true,
              "subName": "post_display",
              "label": "Display Post By",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "post_display": "recent"
                  }
                }
              },
              "displayCondition": {
                "show_if_not": {
                  "use_current_loop": "on",
                  "related_posts": "on"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "recent": {
                      "label": "Recent"
                    },
                    "by_category": {
                      "label": "By Category"
                    },
                    "by_tag": {
                      "label": "By Tag"
                    }
                  }
                }
              }
            },
            "include_categories": {
              "groupSlug": "settings",
              "render": true,
              "subName": "include_categories",
              "label": "Include Categories",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "displayCondition": {
                "show_if": {
                  "post_display": "by_category"
                },
                "show_if_not": {
                  "use_current_loop": "on",
                  "related_posts": "on"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/checkboxes",
                "props": {
                  "options": []
                }
              }
            },
            "include_tags": {
              "groupSlug": "settings",
              "render": true,
              "subName": "include_tags",
              "label": "Include Tags",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "displayCondition": {
                "show_if": {
                  "post_display": "by_tag"
                },
                "show_if_not": {
                  "use_current_loop": "on",
                  "related_posts": "on"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/checkboxes",
                "props": {
                  "options": []
                }
              }
            },
            "orderby": {
              "groupSlug": "settings",
              "render": true,
              "subName": "orderby",
              "label": "Orderby",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "orderby": "1"
                  }
                }
              },
              "displayCondition": {
                "show_if_not": {
                  "post_display": [
                    "by_category",
                    "by_tag"
                  ],
                  "use_current_loop": "on",
                  "related_posts": "on"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "1": {
                      "label": "Newest to oldest"
                    },
                    "2": {
                      "label": "Oldest to newest"
                    },
                    "3": {
                      "label": "Random"
                    }
                  }
                }
              }
            },
            "offset_number": {
              "groupSlug": "settings",
              "render": true,
              "subName": "offset_number",
              "label": "Post Offset Number",
              "description": "Choose how many posts you would like to skip. These posts will not be shown in the feed.",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "displayCondition": {
                "show_if": {
                  "related_posts": "off"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "related_posts": {
              "groupSlug": "settings",
              "render": true,
              "priority": 1,
              "subName": "related_posts",
              "label": "Related Post",
              "description": "Display related posts for single post. This will only work for single post.",
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "related_posts": "off"
                  }
                }
              },
              "displayCondition": {
                "show_if": {
                  "function.isTBLayout": "on",
                  "use_current_loop": "off"
                },
                "show_if_not": {
                  "use_current_loop": "on"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
