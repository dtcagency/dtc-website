              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false,
                "preset": "content"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "rating_scale_type": "5"
                  }
                }
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "5": {
                      "label": "0-5"
                    },
                    "10": {
                      "label": "0-10"
                    }
                  }
                }
              }
            },
            "rating_value_5": {
              "groupSlug": "rating",
              "render": true,
              "subName": "rating_value_5",
