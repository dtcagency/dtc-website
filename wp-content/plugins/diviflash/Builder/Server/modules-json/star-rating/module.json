    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "rating": {
        "priority": 0,
        "panel": "content",
        "groupName": "rating",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Rating"
          }
        }
      },
      "design_rating": {
        "panel": "design",
        "groupName": "design_rating",
