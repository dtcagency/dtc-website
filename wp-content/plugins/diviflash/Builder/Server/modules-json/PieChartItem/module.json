{
    "name": "difl/piechartitem",
    "d4Shortcode": "difl_piechartitem",
    "title": "Pie Chart Item",
    "titles": "Pie Chart Items",
    "category": "child-module",
    "parentsName": [
        "difl/piechart"
    ],
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label",
                            "props": { "groupLabel": "Meta" }
                        }
                    }
                },
                "advanced": {
                    "htmlAttributes": {}
                },
                "decoration": {
                    "conditions": {},
                    "disabledOn": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Pie Chart Item"
                        }
                    }
                }
            }
        },
        "slice_settings": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "slice_label": {
                            "groupSlug": "slice_content",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "slice_label",
                            "label": "Slice Label",
                            "description": "Label shown in legend and tooltip for this slice.",
                            "features": {
                                "sticky": false,
                                "hover": false,
                                "responsive": false,
                                "dynamicContent": {
                                    "type": "text"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "Slice 1"
                                }
                            }
                        },
                        "slice_value": {
                            "groupSlug": "slice_content",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "slice_value",
                            "label": "Value",
                            "description": "Numeric value for this slice.",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 1000,
                                    "step": 1,
                                    "unitless": true,
                                    "allowedUnits": [""],
                                    "defaultUnit": ""
                                }
                            }
                        },
                        "slice_color": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "slice_color",
                            "label": "Slice Color",
                            "description": "Background color of this slice.",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "slice_hover_color": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "slice_hover_color",
                            "label": "Slice Hover Color",
                            "description": "Color when hovering over the slice. Leave empty to use slice color.",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "slice_offset": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "slice_offset",
                            "label": "Slice Offset (Explode)",
                            "description": "Pull this slice away from center by this many pixels.",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "unitless": true
                                }
                            }
                        },
                        "use_gradient": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "use_gradient",
                            "label": "Use Gradient",
                            "description": "Apply a vertical gradient to this slice.",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            }
                        },
                        "gradient_from": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "gradient_from",
                            "label": "Gradient From",
                            "description": "Starting color of the gradient (top).",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "show_if": { "use_gradient": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        },
                        "gradient_to": {
                            "groupSlug": "slice_style",
                            "render": true,
                            "attrName": "slice_settings.innerContent",
                            "subName": "gradient_to",
                            "label": "Gradient To",
                            "description": "Ending color of the gradient (bottom).",
                            "features": { "sticky": false, "hover": false, "responsive": false },
                            "show_if": { "use_gradient": "on" },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker",
                                "props": {}
                            }
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "slice_label": "Slice 1",
                            "slice_value": "25",
                            "slice_color": "",
                            "slice_hover_color": "",
                            "slice_offset": "0",
                            "use_gradient": "off",
                            "gradient_from": "#4285F4",
                            "gradient_to": "#1a56db"
                        }
                    }
                }
            }
        }
    },
    "customCssFields": {},
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "slice_content": {
                "panel": "content",
                "groupName": "slice_content",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Slice Content"
                    }
                }
            },
            "slice_style": {
                "panel": "design",
                "priority": 5,
                "groupName": "slice_style",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Slice Style"
                    }
                }
            }
        }
    },
    "childrenName": [],
    "allowAllElements": false
}