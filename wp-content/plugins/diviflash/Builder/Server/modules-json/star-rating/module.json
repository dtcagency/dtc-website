              },
              "displayCondition": {
                "show_if": {
                  "rating_scale_type": "5"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 5,
                  "minLimit": 0,
                  "maxLimit": 5,
                  "defaultUnit": "",
                  "step": 0.1
                }
              }
            },
            "rating_value_10": {
              "groupSlug": "rating",
              "render": true,
              "subName": "rating_value_10",
              "label": "Rating Value",
              "description": "Set Rating Value",
              "features": {
