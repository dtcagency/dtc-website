              "priority": 100,
              "features": {
                "sticky": false
              },
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": false
                }
              }
            }
          },
          "sizing": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "conditions": {},
          "disabledOn": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "interactions": {},
          "sticky": {},
          "transition": {},
          "zIndex": {}
        }
