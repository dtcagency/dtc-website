{
  "name": "difl/floatimageitem",
  "d4Shortcode": "difl_floatimageitem",
  "title": "Floating Image Item",
  "category": "child-module",
  "parentsName": [
    "difl/floatimage"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "image": {
        "panel": "content",
        "groupName": "image",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image"
          }
        }
      },
      "fii_sizing": {
        "panel": "content",
        "groupName": "fii_sizing",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image Sizing"
          }
        }
      },
      "fii_position": {
        "panel": "content",
        "groupName": "fii_position",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image Position"
          }
        }
      },
      "fii_animation": {
        "panel": "content",
        "groupName": "fii_animation",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Animation Settings"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "contentLink",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      },
      "image_shadow": {
        "panel": "design",
        "groupName": "image_shadow",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image Shadow"
          }
        }
      },
      "image_border": {
        "panel": "design",
        "groupName": "image_border",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image border"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "background": {},
          "interactions": {},
          "border": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "overflow": {},
          "scroll": {},
          "spacing": {},
          "sticky": {},
          "transition": {}
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Floating Image Item"
            }
          }
        }
      }
    },
    "admin_label": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "admin_label",
            "attrName": "admin_label.innerContent",
            "label": "Admin Label",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        }
      },
      "inlineEditor": "plainText"
    },
    "fii_max_width": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_sizing",
            "attrName": "fii_max_width.innerContent",
            "label": "Image Max Width",
            "render": true,
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "cssProperty": "max-width",
                "min": 0,
                "max": 1000,
                "step": 1,
                "minLimit": 0,
                "maxLimit": 1000
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "auto"
          }
        }
      }
    },
    "fii_max_height": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_sizing",
            "attrName": "fii_max_height.innerContent",
            "label": "Image Max Height",
            "render": true,
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "cssProperty": "max-height",
                "min": 0,
                "max": 1000,
                "step": 1,
                "minLimit": 0,
                "maxLimit": 1000
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "auto"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "image",
            "attrName": "image.innerContent",
            "label": "Image",
            "render": true,
            "features": {
              "dynamicContent": {
                "type": "image"
              },
              "preset": "content"
            },
            "component": {
              "type": "field",
              "name": "divi/upload"
            }
          }
        },
        "decoration": {
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image_shadow",
              "attrName": "image.decoration.boxShadow",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": false
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image_border",
              "attrName": "image.decoration.border",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "boxShadow": {
          "selector": ".difl_floatimage {{baseSelector}} .df_fii_container img"
        },
        "border": {
          "selector": ".difl_floatimage {{baseSelector}} .df_fii_container img"
        }
      }
    },
    "alt_text": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "image",
            "attrName": "alt_text.innerContent",
            "label": "Image Alt Text",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        }
      },
      "inlineEditor": "plainText"
    },
    "horizontal_position": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_position",
            "attrName": "horizontal_position.innerContent",
            "label": "Horizontal Position",
            "render": true,
            "description": "Horizontal position of the image.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 0,
                "max": 100,
                "step": 1
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "0%"
          }
        }
      }
    },
    "vertical_position": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_position",
            "attrName": "vertical_position.innerContent",
            "label": "Vertical Position",
            "render": true,
            "description": "Vertical position of the image.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 0,
                "max": 100,
                "step": 1
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "0%"
          }
        }
      }
    },
    "animation_type": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_animation",
            "attrName": "animation_type.innerContent",
            "label": "Animation type",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/select",
              "props": {
                "options": {
                  "fi-up-down": {
                    "label": "Up and Down"
                  },
                  "fi-left-right": {
                    "label": "Left and Right"
                  }
                }
              }
            },
            "features": {
              "preset": "content"
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "fi-up-down"
          }
        }
      }
    },
    "vertical_anime_distance": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_animation",
            "attrName": "vertical_anime_distance.innerContent",
            "label": "Animation Distance Vertical (px/%)",
            "render": true,
            "show_if_not": {
              "animation_type": "fi-left-right"
            },
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": -200,
                "max": 200,
                "step": 1,
                "minLimit": -200,
                "maxLimit": 200,
                "defaultUnit": "px",
                "allowedUnits": [
                  "px",
                  "%"
                ]
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "20px"
          }
        }
      }
    },
    "horizontal_anime_distance": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_animation",
            "attrName": "horizontal_anime_distance.innerContent",
            "label": "Animation Distance Horizontal (px/%)",
            "render": true,
            "show_if": {
              "animation_type": "fi-left-right"
            },
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": -200,
                "max": 200,
                "step": 1,
                "minLimit": -200,
                "maxLimit": 200,
                "defaultUnit": "px",
                "allowedUnits": [
                  "px",
                  "%"
                ]
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "20px"
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_animation",
            "attrName": "duration.innerContent",
            "label": "Duration (ms)",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 100,
                "max": 20000,
                "step": 50,
                "minLimit": 100,
                "maxLimit": 20000,
                "defaultUnit": "",
                "allowedUnit": []
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "4000"
          }
        }
      }
    },
    "delay": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "fii_animation",
