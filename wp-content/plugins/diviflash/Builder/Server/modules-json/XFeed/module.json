{
    "name": "difl/xfeed",
    "d4Shortcode": "difl_xfeed",
    "title": "X Feed (Twitter)",
    "category": "module",
    "moduleIcon": "difl/xfeed",
    "allowAllElements": false,
    "customCssFields": {
        "x_wrapper": {
            "label": "X Widget Wrapper",
            "selectorSuffix": " .df_x_feed_wrapper",
            "subName": "x_wrapper"
        },
        "x_widget": {
            "label": "X Widget Container",
            "selectorSuffix": " .df_x_widget",
            "subName": "x_widget"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "styleProps": {
                "spacing": {
                    "important": {
                        "desktop": {
                            "value": {
                                "margin": true
                            }
                        }
                    }
                }
            },
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "spacing": {},
                    "border": {},
                    "boxShadow": {},
                    "sizing": {},
                    "overflow": {},
                    "filters": {},
                    "transform": {},
                    "animation": {},
                    "position": {},
                    "sticky": {},
                    "zIndex": {},
                    "conditions": {},
                    "disabledOn": {},
                    "transition": {},
                    "interactions": {}
                },
                "advanced": {
                    "htmlAttributes": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "X Feed (Twitter)"
                        }
                    }
                }
            }
        },
        "x_settings": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "innerContent": {
                    "groupType": "group-items",
                    "items": {
                        "plugin_type": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "plugin_type",
                            "label": "Plugin Type",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "tweet": {
                                            "label": "Tweet / Post"
                                        },
                                        "follow": {
                                            "label": "Follow Button"
                                        },
                                        "share": {
                                            "label": "Share Button"
                                        }
                                    }
                                }
                            },
                            "description": "Choose the type of X (Twitter) widget to display."
                        },
                        "language": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "language",
                            "label": "Language",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "en": {
                                            "label": "English"
                                        },
                                        "es": {
                                            "label": "Spanish"
                                        },
                                        "fr": {
                                            "label": "French"
                                        },
                                        "de": {
                                            "label": "German"
                                        },
                                        "it": {
                                            "label": "Italian"
                                        },
                                        "pt": {
                                            "label": "Portuguese"
                                        },
                                        "ar": {
                                            "label": "Arabic"
                                        },
                                        "hi": {
                                            "label": "Hindi"
                                        },
                                        "ja": {
                                            "label": "Japanese"
                                        },
                                        "ko": {
                                            "label": "Korean"
                                        },
                                        "zh-cn": {
                                            "label": "Chinese (Simplified)"
                                        },
                                        "zh-tw": {
                                            "label": "Chinese (Traditional)"
                                        },
                                        "nl": {
                                            "label": "Dutch"
                                        },
                                        "ru": {
                                            "label": "Russian"
                                        },
                                        "tr": {
                                            "label": "Turkish"
                                        },
                                        "pl": {
                                            "label": "Polish"
                                        },
                                        "sv": {
                                            "label": "Swedish"
                                        },
                                        "th": {
                                            "label": "Thai"
                                        },
                                        "vi": {
                                            "label": "Vietnamese"
                                        },
                                        "bn": {
                                            "label": "Bengali"
                                        }
                                    }
                                }
                            },
                            "description": "Set the display language for the embedded widget."
                        },
                        "x_align": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "x_align",
                            "label": "Alignment",
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "left": {
                                            "label": "Left"
                                        },
                                        "center": {
                                            "label": "Center"
                                        },
                                        "right": {
                                            "label": "Right"
                                        }
                                    }
                                }
                            },
                            "description": "Align the widget to the left, center, or right within the module."
                        },
                        "tweet_url": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "tweet_url",
                            "label": "Tweet URL",
                            "render": true,
                            "show_if": {
                                "plugin_type": "tweet"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "https://x.com/username/status/123456789"
                                }
                            },
                            "description": "Enter the full URL of the tweet or post you want to embed."
                        },
                        "tweet_theme": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "tweet_theme",
                            "label": "Theme",
                            "render": true,
                            "show_if": {
                                "plugin_type": "tweet"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "light": {
                                            "label": "Light"
                                        },
                                        "dark": {
                                            "label": "Dark"
                                        }
                                    }
                                }
                            },
                            "description": "Choose between a light or dark theme for the embedded tweet."
                        },
                        "tweet_cards": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "tweet_cards",
                            "label": "Media Cards",
                            "render": true,
                            "show_if": {
                                "plugin_type": "tweet"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "visible": {
                                            "label": "Visible"
                                        },
                                        "hidden": {
                                            "label": "Hidden"
                                        }
                                    }
                                }
                            },
                            "description": "Show or hide media cards (images, videos, link previews) in the tweet."
                        },
                        "tweet_width": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "tweet_width",
                            "label": "Width",
                            "render": true,
                            "show_if": {
                                "plugin_type": "tweet"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "min": 220,
                                    "max": 550,
                                    "step": 1,
                                    "defaultUnit": ""
                                }
                            },
                            "description": "Set the width of the embedded tweet in pixels (220\u2013550)."
                        },
                        "follow_username": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "follow_username",
                            "label": "Username",
                            "render": true,
                            "show_if": {
                                "plugin_type": "follow"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "elonmusk"
                                }
                            },
                            "description": "Enter the X username (without @) for the follow button."
                        },
                        "follow_show_username": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "follow_show_username",
                            "label": "Show Username",
                            "render": true,
                            "show_if": {
                                "plugin_type": "follow"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/toggle"
                            },
                            "description": "Display the username next to the follow button."
                        },
                        "follow_size": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "follow_size",
                            "label": "Size",
                            "render": true,
                            "show_if": {
                                "plugin_type": "follow"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "small": {
                                            "label": "Small"
                                        },
                                        "large": {
                                            "label": "Large"
                                        }
                                    }
                                }
                            },
                            "description": "Choose the size of the follow button."
                        },
                        "share_url": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "share_url",
                            "label": "URL to Share",
                            "render": true,
                            "show_if": {
                                "plugin_type": "share"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "https://example.com"
                                }
                            },
                            "description": "Enter the URL you want to share via the share button."
                        },
                        "share_text": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "share_text",
                            "label": "Pre-filled Text",
                            "render": true,
                            "show_if": {
                                "plugin_type": "share"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "Check this out!"
                                }
                            },
                            "description": "Pre-fill the post text when users click the share button."
                        },
                        "share_hashtags": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "share_hashtags",
                            "label": "Hashtags",
                            "render": true,
                            "show_if": {
                                "plugin_type": "share"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "react,javascript"
                                }
                            },
                            "description": "Add hashtags to the shared post (comma-separated, without #)."
                        },
                        "share_via": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "share_via",
                            "label": "Via (Credit Account)",
                            "render": true,
                            "show_if": {
                                "plugin_type": "share"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/text",
                                "props": {
                                    "placeholder": "username"
                                }
                            },
                            "description": "Credit an X account as the source of the shared content."
                        },
                        "share_size": {
                            "groupSlug": "general_settings",
                            "attrName": "x_settings.innerContent",
                            "subName": "share_size",
                            "label": "Size",
                            "render": true,
                            "show_if": {
                                "plugin_type": "share"
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/select",
                                "props": {
                                    "options": {
                                        "small": {
                                            "label": "Small"
                                        },
                                        "large": {
                                            "label": "Large"
                                        }
                                    }
                                }
                            },
                            "description": "Choose the size of the share button."
                        }
                    }
                }
            },
            "default_value": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "plugin_type": "tweet",
                            "language": "en",
                            "x_align": "center",
                            "tweet_url": "",
                            "tweet_theme": "light",
                            "tweet_cards": "visible",
                            "tweet_width": "",
                            "follow_username": "",
                            "follow_show_username": "on",
                            "follow_size": "small",
                            "share_url": "",
                            "share_text": "",
                            "share_hashtags": "",
                            "share_via": "",
                            "share_size": "small"
                        }
                    }
                }
            }
        },
        "css": {
            "type": "object",
            "settings": {
                "advanced": {
                    "customCss": {},
                    "cssId": {},
                    "cssClass": {}
                }
            }
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "general_settings": {
                "panel": "content",
                "groupName": "general_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "General Settings"
                    }
                }
            }
        }
    }
}