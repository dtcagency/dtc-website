                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": "company_logo",
                    "id": false,
                    "alt": false,
                    "titleText": false,
                    "width": false,
                    "height": false
                  }
                }
              }
            },
            "company_logo_alt_text": {
              "groupSlug": "images",
              "attrName": "item_images.innerContent",
              "subName": "company_logo_alt_text",
              "label": "Company Logo Alt Text",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        }
      }
    },
    "item_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "enable_rating": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "enable_rating",
              "label": "Enable Rating",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "rating_scale_type": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "rating_scale_type",
              "label": "Rating Scale Type",
              "render": true,
              "show_if": {
                "enable_rating": "on"
              },
              "description": "Choose Rating Scale Type",
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "5": {
                      "label": "0-5"
                    },
                    "10": {
                      "label": "0-10"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "rating_value_5": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "rating_value_5",
              "label": "Rating Value",
              "render": true,
              "show_if": {
                "enable_rating": "on",
                "rating_scale_type": "5"
              },
              "description": "Set Rating Value",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0.1,
                  "max": 5,
                  "step": 0.1,
                  "minLimit": 0,
                  "maxLimit": 5,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "rating_value_10": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "rating_value_10",
              "label": "Rating Value",
              "render": true,
              "show_if": {
                "enable_rating": "on",
                "rating_scale_type": "10"
              },
              "description": "Set Rating Value",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0.1,
                  "max": 10,
                  "step": 0.1,
                  "minLimit": 0,
                  "maxLimit": 10,
                  "defaultUnit": "",
                  "allowedUnits": [
                    ""
                  ]
                }
              }
            },
            "quote_icon_image": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "quote_icon_image",
              "label": "Image for Quote Icon",
              "render": true,
              "show_if": {
                "quote_icon_use_icon": "off"
              },
              "features": {
                "responsive": false,
                "preset": "content",
                "dynamicContent": {
                  "type": "image"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/upload",
                "props": {
                  "syncImageData": {
                    "src": "quote_icon_image",
                    "id": true,
                    "alt": true,
                    "titleText": true
                  }
                }
              }
            },
            "quote_icon_alt_text": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "quote_icon_alt_text",
              "label": "Image Alt Text",
              "render": true,
              "show_if": {
                "quote_icon_use_icon": "off"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "quote_icon_use_icon": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "quote_icon_use_icon",
              "label": "Enable Quote Icon",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "quote_icon_font_icon": {
              "groupSlug": "settings",
              "attrName": "item_settings.innerContent",
              "subName": "quote_icon_font_icon",
              "label": "Icon",
              "render": true,
              "show_if": {
                "quote_icon_use_icon": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/icon-picker"
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "enable_rating": "off",
              "rating_scale_type": "5",
              "rating_value_5": "5",
              "rating_value_10": "10",
              "quote_icon_use_icon": "off"
            }
          }
        }
      }
    },
