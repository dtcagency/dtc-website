    "ticker_hover": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "settings",
            "attrName": "ticker_hover.innerContent",
            "label": "Pause On Hover",
            "render": true,
            "description": "Animation will pause on mouse hover.",
            "component": {
              "type": "field",
              "name": "divi/toggle"
            },
            "features": {
              "preset": "content"
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "ticker_loop": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "settings",
            "attrName": "ticker_loop.innerContent",
            "label": "Loop",
            "render": true,
            "description": "The marquee will be duplicated to show the effect of continuous flow.",
            "component": {
              "type": "field",
              "name": "divi/toggle"
            },
            "features": {
              "preset": "content"
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "ticker_gap": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "settings",
            "attrName": "ticker_gap.innerContent",
            "label": "Gap",
            "render": true,
            "description": "Here, you can control the space in pixels between the items.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": "0",
                "min_limit": 0,
                "max": "1000",
                "step": "1"
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "10px"
          }
        }
      }
    },
    "ticker_speed": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "settings",
            "attrName": "ticker_speed.innerContent",
            "label": "Speed (ms)",
            "render": true,
            "description": "Here you can control the speed of animation.",
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 1,
                "min_limit": 1,
                "max": 50000,
                "step": 1,
                "allowedUnits": [],
                "defaultUnit": ""
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "10000"
