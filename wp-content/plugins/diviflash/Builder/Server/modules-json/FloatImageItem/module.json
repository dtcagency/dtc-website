                  "easeInCubic": {
                    "label": "easeInCubic"
                  },
                  "easeInQuart": {
                    "label": "easeInQuart"
                  },
                  "easeInQuint": {
                    "label": "easeInQuint"
                  },
                  "easeInSine": {
