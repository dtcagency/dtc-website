                    "right": {
                      "label": "Right"
                    },
                    "right-start": {
                      "label": "Right Start"
                    },
                    "right-end": {
                      "label": "Right End"
                    },
                    "bottom": {
                      "label": "Bottom"
                    },
                    "bottom-start": {
                      "label": "Bottom Start"
                    },
                    "bottom-end": {
                      "label": "Bottom End"
                    },
                    "left": {
                      "label": "Left"
                    },
                    "left-start": {
                      "label": "Left Start"
                    },
                    "left-end": {
                      "label": "Left End"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_animation": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_animation",
              "label": "Animation",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "fade": {
                      "label": "Fade"
                    },
                    "scale": {
                      "label": "Scale"
                    },
                    "rotate": {
                      "label": "Rotate"
                    },
                    "shift-away": {
                      "label": "Shift Away"
                    },
                    "shift-toward": {
                      "label": "Shift Toward"
                    },
                    "perspective": {
                      "label": "Perspective"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_trigger": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_trigger",
              "label": "Trigger",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "mouseenter focus": {
                      "label": "Hover"
                    },
                    "click": {
                      "label": "Click"
                    },
                    "mouseenter click": {
                      "label": "Hover And Click"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_mouse_style": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_mouse_style",
              "label": "Cursor Style",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "default": {
                      "label": "Default"
                    },
                    "help": {
                      "label": "Help"
                    },
                    "context-menu": {
                      "label": "Context Menu"
                    },
                    "pointer": {
                      "label": "Pointer"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_duration": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_duration",
              "label": "Transition Duration",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "description": "Specifies the duration of the transition.",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "1000",
                  "step": "1"
                }
              }
            },
            "feature_text_tooltip_interactive": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_interactive",
              "label": "Hover Over Tooltip",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "description": "Tooltip allowing you to hover over and click inside it.",
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_interactive_border": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_interactive_border",
              "label": "Tooltip Hover Area",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on",
                "feature_text_tooltip_interactive": "on"
              },
              "description": "Determines the size of the invisible border around the tooltip that will prevent it from hiding if the cursor left it.",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "100",
                  "step": "1",
                  "allowedUnits": [],
                  "defaultUnit": ""
                }
              }
            },
            "feature_text_tooltip_interactive_debounce": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_interactive_debounce",
              "label": "Tooltip Content Hide Delay",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on",
                "feature_text_tooltip_interactive": "on"
              },
              "description": "Determines the time in ms to debounce the Tooltip content hide handler when the cursor leaves.",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "1000",
                  "step": "10",
                  "allowedUnits": [],
                  "defaultUnit": ""
                }
              }
            },
            "feature_text_tooltip_max_width": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_max_width",
              "label": "Max Width",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "description": "Specifies the maximum width of the tooltip. Useful to prevent it from being too horizontally wide to read.",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "1000",
                  "step": "1"
                }
              }
            },
            "feature_text_tooltip_offset_distance_vertical": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_offset_distance_vertical",
              "label": "Vertical Distance ",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "description": "Tooltip Distance length from spot to tooltip",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "100",
                  "step": "1",
                  "allowedUnits": [],
                  "defaultUnit": ""
                }
              }
            },
            "feature_text_tooltip_offset_distance": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_offset_distance",
              "label": "Horizontal Distance",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "description": "Tooltip Distance length from spot to tooltip",
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "100",
                  "step": "1",
                  "allowedUnits": [],
                  "defaultUnit": ""
                }
              }
            }
          }
        },
        "decoration": {
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.decoration.boxShadow",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "boxShadow": {
          "selector": "{{selector}} .tippy-box[data-theme*=\".difl_pricingtableitem_\"]"
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "feature_text_tooltip_placement": "right",
              "feature_text_tooltip_animation": "scale",
              "feature_text_tooltip_trigger": "mouseenter focus",
              "feature_text_tooltip_mouse_style": "help",
              "feature_text_tooltip_duration": "300ms",
              "feature_text_tooltip_interactive": "on",
              "feature_text_tooltip_interactive_border": "2",
              "feature_text_tooltip_max_width": "350px",
              "feature_text_tooltip_offset_distance_vertical": "0",
              "feature_text_tooltip_offset_distance": "10"
            }
          }
        }
      }
