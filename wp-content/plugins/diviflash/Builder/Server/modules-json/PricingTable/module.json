{
  "name": "difl/pricingtable",
  "d4Shortcode": "difl_pricingtable",
  "title": "Advanced Pricing Table",
  "category": "module",
  "childModuleName": "difl/pricingtableitem",
  "childModuleTitle": "Item",
  "childModuleTitleAttribute": "item_type",
  "childrenName": [
    "difl/pricingtableitem"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "main_content": {
        "panel": "content",
        "groupName": "main_content",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements Animation"
          }
        }
      },
      "tooltip": {
        "panel": "content",
        "groupName": "tooltip",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Feature Tooltip"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "contentLink",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      }
    }
  },
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "attributes": {},
          "interactions": {},
          "animation": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Advanced Pricing Table"
            }
          }
        }
      }
    },
    "animation_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "enable_animation": {
              "groupSlug": "main_content",
              "attrName": "animation_settings.innerContent",
              "subName": "enable_animation",
              "label": "Enable Stagger Animation",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "difl_animation_types": {
              "groupSlug": "main_content",
              "attrName": "animation_settings.innerContent",
              "subName": "difl_animation_types",
              "label": "Types",
              "render": true,
              "show_if": {
                "enable_animation": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "fadeIn": {
                      "label": "Fade In"
                    },
                    "fadeInLeftShort": {
                      "label": "Fade In Left"
                    },
                    "fadeInRightShort": {
                      "label": "Fade In Right"
                    },
                    "fadeInUpShort": {
                      "label": "Fade In Up"
                    },
                    "fadeInDownShort": {
                      "label": "Fade In Down"
                    },
                    "zoomInShort": {
                      "label": "Grow"
                    },
                    "bounceInShort": {
                      "label": "Bounce In"
                    },
                    "bounceInLeftShort": {
                      "label": "Bounce In Left"
                    },
                    "bounceInRightShort": {
                      "label": "Bounce In Right"
                    },
                    "bounceInUpShort": {
                      "label": "Bounce In Up"
                    },
                    "bounceInDownShort": {
                      "label": "Bounce In Down"
                    },
                    "flipInXShort": {
                      "label": "Flip InX"
                    },
                    "flipInYShort": {
                      "label": "Flip InY"
                    },
                    "jackInTheBoxShort": {
                      "label": "Jack In The Box"
                    },
                    "rotateInShort": {
                      "label": "Rotate In"
                    },
                    "rotateInDownLeftShort": {
                      "label": "Rotate In Down Left"
                    },
                    "rotateInUpLeftShort": {
                      "label": "Rotate In Up Left"
                    },
                    "rotateInDownRightShort": {
                      "label": "Rotate In Down Right"
                    },
                    "rotateInUpRightShort": {
                      "label": "Rotate In Up Right"
                    }
                  }
                }
              },
              "features": {
                "preset": "content"
              }
            },
            "difl_animation_delay": {
              "groupSlug": "main_content",
              "attrName": "animation_settings.innerContent",
              "subName": "difl_animation_delay",
              "label": "Delay",
              "render": true,
              "show_if": {
                "enable_animation": "on"
              },
              "features": {
                "responsive": true
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "0",
                  "max": "2000",
                  "step": "100"
                }
              }
            },
            "difl_animation_duration": {
              "groupSlug": "main_content",
              "attrName": "animation_settings.innerContent",
              "subName": "difl_animation_duration",
              "label": "Duration",
              "render": true,
              "show_if": {
                "enable_animation": "on"
              },
              "features": {
                "responsive": true
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": "200",
                  "max": "3000",
                  "step": "100"
                }
              }
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": {
              "enable_animation": "off",
              "difl_animation_types": "fadeInUpShort",
              "difl_animation_delay": "200ms",
              "difl_animation_duration": "500ms"
            }
          }
        }
      }
    },
    "tooltip_settings": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "enable_feature_tooltip": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "enable_feature_tooltip",
              "label": "Enable Tooltip",
              "render": true,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              },
              "features": {
                "preset": "content"
              }
            },
            "feature_text_tooltip_placement": {
              "groupSlug": "tooltip",
              "attrName": "tooltip_settings.innerContent",
              "subName": "feature_text_tooltip_placement",
              "label": "Placement",
              "render": true,
              "show_if": {
                "enable_feature_tooltip": "on"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "top": {
                      "label": "Top"
                    },
                    "top-start": {
                      "label": "Top Start"
