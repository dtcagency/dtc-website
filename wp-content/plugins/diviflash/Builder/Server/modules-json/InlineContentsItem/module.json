{
  "name": "difl/inline-contents-item",
  "d4Shortcode": "difl_inline_contents_item",
  "title": "Inline Content Item",
  "titles": "Inline Content Item",
  "category": "child-module",
  "parentsName": [
    "difl/inline-contents"
  ],
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "content_main": {
        "panel": "content",
        "groupName": "content_main",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "groupName": "contentLink",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      },
      "background": {
        "panel": "content",
        "groupName": "background",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Background"
          }
        }
      },
      "content_text": {
        "panel": "design",
        "groupName": "content_text",
        "multiElements": true,
        "show_if": {
          "content_type": "Text"
        },
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text"
          }
        }
      },
      "content_icon": {
        "panel": "design",
        "groupName": "content_icon",
        "multiElements": true,
        "show_if": {
          "content_type": "Icon"
        },
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Icon"
          }
        }
      },
      "content_media": {
        "panel": "design",
        "groupName": "content_media",
        "multiElements": true,
        "show_if": {
          "content_type": "Image"
        },
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Image"
          }
        }
      }
    }
  },
  "customCssFields": {},
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentLink",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/link",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        },
        "decoration": {
          "interactions": {},
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "background",
              "attrName": "module.decoration.background",
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": false,
                  "hidePanels": [
                    "video",
                    "mask",
                    "pattern"
                  ]
                }
              }
            }
          },
          "border": {},
          "boxShadow": {},
          "disabledOn": {},
          "filters": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {}
        }
      },
      "styleProps": {
        "sizing": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item"
        },
        "spacing": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item",
          "important": true
        },
        "background": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item"
        },
        "border": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item"
        },
        "boxShadow": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item"
        }
      },
      "default": {
        "type": "object",
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Inline Content Item"
            }
          }
        },
        "decoration": {
          "background": {
            "desktop": {
              "value": {
                "image": {
                  "size": "cover",
                  "position": "center"
                }
              }
            }
          }
        }
      }
    },
    "admin_label": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "admin_label",
            "attrName": "admin_label.innerContent",
            "label": "Admin Label",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        }
      },
      "inlineEditor": "plainText"
    },
    "content_type": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_main",
            "attrName": "content_type.innerContent",
            "label": "Content Type",
            "render": true,
            "component": {
              "type": "field",
              "name": "divi/select",
              "props": {
                "options": {
                  "Text": {
                    "label": "Text"
                  },
                  "Icon": {
                    "label": "Icon"
                  },
                  "Image": {
                    "label": "Image"
                  },
                  "Line_Break": {
                    "label": "Line Break"
                  }
                }
              }
            },
            "features": {
              "preset": "content"
            }
          }
        }
      },
      "default_value": {
        "innerContent": {
          "desktop": {
            "value": "Text"
          }
        }
      }
    },
    "content_text": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_main",
            "attrName": "content_text.innerContent",
            "label": "Content Text",
            "render": true,
            "show_if": {
              "content_type": "Text"
            },
            "description": "Write your desire text.",
            "features": {
              "responsive": false,
              "dynamicContent": {
                "type": "text"
              },
              "preset": "content"
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "content_text",
              "attrName": "content_text.decoration.font",
              "render": true,
              "show_if": {
                "content_type": "Text"
              },
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false
                }
              }
            }
          }
        }
      },
      "inlineEditor": "plainText",
      "styleProps": {
        "font": {
          "selector": "#difl-inline-contents-container {{baseSelector}}.difl_inline_contents_item .difl_inline_content_text"
        }
      }
    },
    "content_icon": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_main",
            "attrName": "content_icon.innerContent",
            "label": "Content Icon",
            "render": true,
            "show_if": {
              "content_type": "Icon"
            },
            "description": "Choose an icon to display with your Inline Content.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/icon-picker"
            }
          }
        }
      }
    },
    "content_image": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_main",
            "attrName": "content_image.innerContent",
            "label": "Content Image",
            "render": true,
            "show_if": {
              "content_type": "Image"
            },
            "description": "Upload your desired image, or type in the URL to the image you would like to display.",
            "features": {
              "responsive": true,
              "preset": "content",
              "dynamicContent": {
                "type": "image"
              }
            },
            "component": {
              "type": "field",
              "name": "divi/upload"
            }
          }
        }
      }
    },
    "icon_color": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_icon",
            "attrName": "icon_color.innerContent",
            "label": "Icon Color",
            "render": true,
            "show_if": {
              "content_type": "Icon"
            },
            "description": "Here you can define a custom color for your icon.",
            "component": {
              "type": "field",
              "name": "divi/color-picker"
            }
          }
        }
      }
    },
    "icon_size": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_icon",
            "attrName": "icon_size.innerContent",
            "label": "Icon Size",
            "render": true,
            "show_if": {
              "content_type": "Icon"
            },
            "description": "Here you can choose Icon Size.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 1,
                "max": 200,
                "step": 1
              }
            }
          }
        }
      }
    },
    "media_size": {
      "type": "object",
      "selector": "{{baseSelector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "content_media",
            "attrName": "media_size.innerContent",
            "label": "Image Size",
            "render": true,
            "show_if": {
              "content_type": "Image"
            },
            "description": "Here you can choose Image Size.",
            "features": {
              "responsive": true
            },
            "component": {
              "type": "field",
              "name": "divi/range",
              "props": {
                "min": 1,
                "max": 200,
                "step": 1
              }
            }
          }
        }
      }
    }
  },
  "wrapper": {
    "tag": "span"
  }
}
