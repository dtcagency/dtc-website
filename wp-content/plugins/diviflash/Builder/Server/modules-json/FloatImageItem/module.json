                  },
                  "easeInOutExpo": {
                    "label": "easeInOutExpo"
                  },
                  "easeInOutCirc": {
                    "label": "easeInOutCirc"
                  },
                  "easeInOutBack": {
                    "label": "easeInOutBack"
                  },
                  "easeInOutBounce": {
                    "label": "easeInOutBounce"
                  },
                  "easeOutQuad": {
                    "label": "easeOutQuad"
                  },
                  "easeOutCubic": {
                    "label": "easeOutCubic"
                  },
                  "easeOutQuart": {
                    "label": "easeOutQuart"
                  },
                  "easeOutQuint": {
                    "label": "easeOutQuint"
                  },
                  "easeOutSine": {
                    "label": "easeOutSine"
                  },
                  "easeOutExpo": {
                    "label": "easeOutExpo"
                  },
                  "easeOutCirc": {
                    "label": "easeOutCirc"
                  },
                  "easeOutBack": {
                    "label": "easeOutBack"
                  },
                  "easeOutBounce": {
