        "boxShadow": {
          "selectors": {
            "desktop": {
              "value": " {{selector}}  .difl-divider-shadow .difl-divider-left-side hr,{{selector}} .difl-divider-shadow .difl-divider-right-side hr,{{selector}} .difl-divider-custom .difl-divider-left-side hr,{{selector}} .difl-divider-custom .difl-divider-right-side hr"
