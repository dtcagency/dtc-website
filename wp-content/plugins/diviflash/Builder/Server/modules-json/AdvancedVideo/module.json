              "attrName": "source_settings.innerContent",
              "subName": "external_url",
              "label": "Video URL",
              "render": true,
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "external_url": "https://www.youtube.com/watch?v=ScMzIvxBSi4"
